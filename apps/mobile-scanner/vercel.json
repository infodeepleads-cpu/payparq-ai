{
  "buildCommand": "git clone https://github.com/flutter/flutter.git -b stable $HOME/.flutter && export PATH=\"$HOME/.flutter/bin:$PATH\" && cd apps/mobile-scanner && flutter config --enable-web && flutter pub get && flutter build web --release && echo \"{\\\"sha\\\": \\\"$VERCEL_GIT_COMMIT_SHA\\\"}\" > build/web/version.json",
  "outputDirectory": "apps/mobile-scanner/build/web",
  "installCommand": "echo 'Installing Flutter...'",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*\\.map)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*\\.apk)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"app-release.apk\""
        },
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        }
      ]
    }
  ]
}
